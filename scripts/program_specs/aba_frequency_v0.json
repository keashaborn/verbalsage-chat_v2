{
  "name": "Aggression Episodes (daily count)",
  "measurement": {
    "type": "count",
    "per": "day"
  },
  "graph_spec_v0": {
    "kind": "aba_line_v0",
    "x": {
      "label": "Date",
      "mode_default": "date"
    },
    "y": {
      "label": "Aggression episodes",
      "unit": "count",
      "include_zero": true
    },
    "phase_change": {
      "enabled": true
    }
  },
  "fields": [
    {
      "key": "date",
      "type": "string",
      "format": "date",
      "title": "Date",
      "required": true
    },
    {
      "key": "count",
      "type": "integer",
      "minimum": 0,
      "title": "Count",
      "required": true
    },
    {
      "key": "context",
      "type": "string",
      "title": "Context"
    },
    {
      "key": "notes",
      "type": "string",
      "title": "Notes",
      "widget": "textarea"
    }
  ]
}
